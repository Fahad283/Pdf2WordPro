# Generate separate URL-safe secrets. See README.md.
POSTGRES_PASSWORD=
SECRET_KEY=
ENVIRONMENT=development
SITE_URL=http://localhost:3000
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false

MAX_UPLOAD_MB=50
MAX_OUTPUT_MB=256
DAILY_CONVERSION_LIMIT=40
METADATA_RETENTION_DAYS=30
MAX_PAGES=500
MAX_BATCH_FILES=10
RETENTION_MINUTES=60
JOB_TIMEOUT_SECONDS=300
OCR_LANGUAGES=eng,urd,ara
WORKER_CONCURRENCY=1

# Benchmark run artifacts expire independently of ordinary conversions.
BENCHMARK_CONCURRENCY=2
BENCHMARK_ARTIFACT_DAYS=14
BENCHMARK_APPLICATION_VERSION=1.0.0+bench.1

# Optional one-time administrator bootstrapping. Remove the password after setup.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Default is the private Docker volume. For S3, configure a private bucket.
STORAGE_BACKEND=local
S3_BUCKET=pdf-pro
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Use compose.scanning.yml for the included ClamAV service.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false

# Only required by the optional HTTPS reverse proxy.
TLS_DIR=
